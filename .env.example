# ─── MiniBank environment configuration example ───────────────────────────────
# Copy this file to .env and fill in the values before running docker compose up.

# ─── Application URL ──────────────────────────────────────────────────────────
# Public HTTPS URL of the application (used in GDPR confirmation email links).
APP_URL=https://localhost

# ─── SMTP — outgoing email for GDPR notifications ─────────────────────────────
# Leave SMTP_HOST empty to disable email sending (emails will be logged to
# the auth_service container console instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@minibank.local

# ─── ELK Stack credentials ────────────────────────────────────────────────────
# Password for the built-in "elastic" superuser.
# Change this before deploying to any non-development environment.
ELASTIC_PASSWORD=minibank_elastic
