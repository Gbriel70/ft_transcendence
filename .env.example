# ─── MiniBank environment configuration example ───────────────────────────────
# Optional: copy this file to .env only if you want to override non-sensitive defaults.
# Sensitive credentials are managed by Vault at runtime.

# ─── Application URL ──────────────────────────────────────────────────────────
# Public HTTPS URL of the application (used in GDPR confirmation email links).
APP_URL=https://localhost

# ─── SMTP — outgoing email for GDPR notifications ─────────────────────────────
# Leave SMTP_HOST empty to disable email sending (emails will be logged to
# the auth_service container console instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=noreply@minibank.local
